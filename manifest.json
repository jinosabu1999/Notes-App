{
    "name": "Velvet Notes",
    "short_name": "Velvet",
    "description": "An elegant, offline-ready notes app with tags, checklists and themes.",
    "id": "./",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#f8fafc",
    "theme_color": "#5a53e8",
    "categories": ["productivity", "utilities"],
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ],
    "shortcuts": [
        {
            "name": "New note",
            "short_name": "New note",
            "url": "./?action=new",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "New checklist",
            "short_name": "Checklist",
            "url": "./?action=checklist",
            "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
        }
    ],
    "share_target": {
        "action": "./?share=1",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    }
}
